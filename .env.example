# Copy to .env and adjust. Every value is optional.

# Data source: "simulated" (no key needed) or "finnhub" (real trades, free key at https://finnhub.io)
DATA_SOURCE=simulated
FINNHUB_API_KEY=

# Comma-separated watchlist. Empty = the built-in list of 12 large caps.
SYMBOLS=

# Milliseconds between published ticks
TICK_INTERVAL_MS=1000

# Minimum milliseconds between two notifications for the same alert rule
ALERT_COOLDOWN_MS=30000

# Optional Slack / Discord / custom webhook that receives every triggered alert
ALERT_WEBHOOK_URL=

# Host ports
GATEWAY_PORT=8080
KAFKA_EXTERNAL_PORT=29092
KAFKA_UI_PORT=8081

LOG_LEVEL=info
